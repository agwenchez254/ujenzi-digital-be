DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ujenzi_digital?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
CSRF_SECRET=replace-with-another-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_ORIGIN=http://localhost:8080,http://localhost:5173,https://your-frontend.vercel.app
PORT=3000
NODE_ENV=development
VAPID_PUBLIC_KEY=replace-with-a-generated-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-a-generated-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ujenzidigital.example

# --- Scaling / availability ---
# Prisma pool per instance. Total DB connections = instances x this value; keep it
# under Postgres max_connections (or put PgBouncer in front and use its URL).
DB_POOL_SIZE=10
# Number of reverse proxies in front of the app (nginx = 1). Needed for correct req.ip.
TRUST_PROXY_HOPS=1
# Log request/response bodies (defaults to true outside production).
# LOG_HTTP_BODIES=false

# Optional. Required when running more than one instance: shares rate-limit counters
# and socket.io events between them. Unset = in-memory (single instance / local dev).
# REDIS_URL=redis://localhost:6379

# End-to-end encrypted chat. "optional" (default): a conversation becomes encrypted, and
# members-only, once its first key is published. "required": every conversation must be
# encrypted and plaintext is refused. Switch to "required" once the apps support E2EE.
# CHAT_E2EE_MODE=optional
