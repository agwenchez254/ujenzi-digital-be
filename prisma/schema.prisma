generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  engineer
  contractor
  site_representative
  administrator
  developer
}

enum InspectionRequestStatus {
  pending
  accepted
  rejected
  completed
  in_progress
}

enum InspectionStatus {
  draft
  in_progress
  submitted
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum DevelopmentType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  MIXED_USE
  INSTITUTIONAL
}

enum SitePersonnelRole {
  DEVELOPER
  SITE_REPRESENTATIVE
  CONTRACTOR
  QUANTITY_SURVEYOR
  ENGINEER
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  passwordHash         String?
  googleId             String?  @unique
  name                 String
  phone                String?
  company              String?
  certificationDetails String?
  avatarUrl            String?
  status               String   @default("active") // active | inactive
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  roles            UserRole[]
  refreshTokens    RefreshToken[]
  sitesOwned       Site[]              @relation("ContractorSites")
  requestsMade     InspectionRequest[] @relation("ContractorRequests")
  requestsAssigned InspectionRequest[] @relation("EngineerRequests")
  inspections      Inspection[]
  auditLogs        AuditLog[]
  sitePersonnel     SitePersonnel[]
  pushSubscriptions PushSubscription[]
}

model UserRole {
  id     String  @id @default(uuid())
  userId String
  role   AppRole
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Site {
  id                String           @id @default(uuid())
  name              String
  contractorId      String
  latitude          Decimal          @db.Decimal(10, 8)
  longitude         Decimal          @db.Decimal(11, 8)
  location          Unsupported("geography(Point,4326)")?
  geofenceRadius    Int              @default(500)
  address           String
  constructionPhase String?
  status            String           @default("active") // active | inactive
  developmentType   DevelopmentType?
  country           String?
  county            String?
  constituency      String?
  town              String?
  plotNumber        String?
  landmarks         String[]         @default([])
  approvals         Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  contractor  User                @relation("ContractorSites", fields: [contractorId], references: [id])
  requests    InspectionRequest[]
  inspections Inspection[]
  personnel   SitePersonnel[]
}

model SitePersonnel {
  id      String            @id @default(uuid())
  siteId  String
  role    SitePersonnelRole
  userId  String?
  name    String?
  contact String?

  site Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([siteId])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InspectionRequest {
  id            String                  @id @default(uuid())
  siteId        String
  contractorId  String
  engineerId    String?
  requestedDate DateTime                @db.Date
  status        InspectionRequestStatus @default(pending)
  notes         String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contractor  User         @relation("ContractorRequests", fields: [contractorId], references: [id])
  engineer    User?        @relation("EngineerRequests", fields: [engineerId], references: [id])
  inspections Inspection[]
}

model Inspection {
  id         String           @id @default(uuid())
  requestId  String
  siteId     String
  engineerId String
  startTime  DateTime?
  endTime    DateTime?
  latitude   Decimal?         @db.Decimal(10, 8)
  longitude  Decimal?         @db.Decimal(11, 8)
  notes      Json?
  riskLevel  RiskLevel?
  status     InspectionStatus @default(draft)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  request  InspectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  site     Site              @relation(fields: [siteId], references: [id])
  engineer User              @relation(fields: [engineerId], references: [id])
  media    Media[]
  reports  Report[]
}

model Media {
  id           String   @id @default(uuid())
  inspectionId String
  type         String   // photo | video
  url          String
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  caption      String?
  createdAt    DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model Report {
  id                String   @id @default(uuid())
  inspectionId      String
  pdfUrl            String?
  engineerSignature String?
  submissionDate    DateTime @default(now())
  version           Int      @default(1)
  createdAt         DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model InspectionTemplate {
  id             String   @id @default(uuid())
  name           String
  description    String?
  checklistItems Json     @default("[]")
  createdBy      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model RolePermission {
  id         String  @id @default(uuid())
  role       AppRole
  permission String

  @@unique([role, permission])
}
