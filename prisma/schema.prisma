generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  engineer
  contractor
  site_representative
  administrator
  developer
}

enum InspectionRequestStatus {
  pending
  accepted
  rejected
  completed
  in_progress
}

enum InspectionStatus {
  draft
  in_progress
  submitted
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum DevelopmentType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  MIXED_USE
  INSTITUTIONAL
}

enum SitePersonnelRole {
  DEVELOPER
  SITE_REPRESENTATIVE
  CONTRACTOR
  QUANTITY_SURVEYOR
  ENGINEER
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String?
  googleId             String?   @unique
  name                 String
  phone                String?
  company              String?
  certificationDetails String?
  avatarUrl            String?
  status               String    @default("active") // active | inactive
  // Email changes require re-verification since email doubles as the login
  // identifier — the new address only takes effect once its link is clicked.
  pendingEmail         String?
  emailChangeTokenHash String?
  emailChangeExpiresAt DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  // Most-recent-first, capped at 2 — checked on reset so a new password can't
  // match the current one or the one before it.
  previousPasswordHashes String[]  @default([])
  emailVerified              Boolean   @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  roles                         UserRole[]
  refreshTokens                 RefreshToken[]
  sitesOwned                    Site[]                 @relation("ContractorSites")
  requestsMade                  InspectionRequest[]    @relation("ContractorRequests")
  requestsAssigned              InspectionRequest[]    @relation("EngineerRequests")
  requestsSubmitted             InspectionRequest[]    @relation("RequestedInspectionRequests")
  inspections                   Inspection[]
  auditLogs                     AuditLog[]
  sitePersonnel                 SitePersonnel[]
  pushSubscriptions             PushSubscription[]
  contractorInvitationsReceived ContractorInvitation[] @relation("InvitedContractor")
  contractorInvitationsSent     ContractorInvitation[] @relation("InvitingDeveloper")
  notifications                 Notification[]
  chatMessages                  ChatMessage[]
  chatDeliveries                ChatDelivery[]
  devices                       UserDevice[]
  keyBackup                     KeyBackup?
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model UserRole {
  id     String  @id @default(uuid())
  userId String
  role   AppRole
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Site {
  id                String                                @id @default(uuid())
  name              String
  contractorId      String
  latitude          Decimal                               @db.Decimal(10, 8)
  longitude         Decimal                               @db.Decimal(11, 8)
  location          Unsupported("geography(Point,4326)")?
  geofenceRadius    Int                                   @default(500)
  address           String
  constructionPhase String?
  status            String                                @default("active") // active | inactive
  developmentType   DevelopmentType?
  country           String?
  county            String?
  constituency      String?
  town              String?
  plotNumber        String?
  expectedEndDate   DateTime?
  landmarks         String[]                              @default([])
  approvals         Json?
  isPubliclyShared  Boolean                               @default(false)
  // Soft delete: hidden everywhere, contents untouched, purged for good after 30 days.
  deletedAt         DateTime?
  deletedById       String?
  createdAt         DateTime                              @default(now())
  updatedAt         DateTime                              @updatedAt

  contractor  User                  @relation("ContractorSites", fields: [contractorId], references: [id])
  requests    InspectionRequest[]
  inspections Inspection[]
  personnel   SitePersonnel[]
  invitation  ContractorInvitation?
  chatMessages ChatMessage[]
  documents    SiteDocument[]

  @@index([deletedAt])
}

model SitePersonnel {
  id      String            @id @default(uuid())
  siteId  String
  role    SitePersonnelRole
  userId  String?
  name    String?
  contact String?

  // Set only for a freeform entry that opted into a signup invitation —
  // mandatory for CONTRACTOR, optional for every other role.
  email                String?
  invitationTokenHash  String?
  invitationExpiresAt  DateTime?
  invitationAcceptedAt DateTime?

  site Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([siteId])
  @@index([userId])
}

model ContractorInvitation {
  id            String    @id @default(uuid())
  siteId        String    @unique
  // Null until the invited email actually has (or creates) an account —
  // a freeform-contact invite starts with no user to point at yet.
  invitedUserId String?
  invitedEmail  String
  invitedById   String
  tokenHash     String
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  site      Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  invited   User? @relation("InvitedContractor", fields: [invitedUserId], references: [id])
  invitedBy User  @relation("InvitingDeveloper", fields: [invitedById], references: [id])

  @@index([invitedUserId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InspectionRequest {
  id                String                  @id @default(uuid())
  siteId            String
  contractorId      String
  engineerId        String?
  // Who actually submitted the request — usually the contractor, but a
  // developer or site representative tied to the same site can also create
  // one, so this can't just be inferred from contractorId. Nullable since
  // rows created before this field existed have no value to backfill.
  requestedByUserId String?
  requestedDate     DateTime                @db.Date
  status            InspectionRequestStatus @default(pending)
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contractor  User         @relation("ContractorRequests", fields: [contractorId], references: [id])
  engineer    User?        @relation("EngineerRequests", fields: [engineerId], references: [id])
  requestedBy User?        @relation("RequestedInspectionRequests", fields: [requestedByUserId], references: [id])
  inspections Inspection[]

  @@index([siteId, status])
  @@index([contractorId])
  @@index([engineerId, status])
}

model Inspection {
  id         String           @id @default(uuid())
  requestId  String
  siteId     String
  engineerId String
  startTime  DateTime?
  endTime    DateTime?
  latitude   Decimal?         @db.Decimal(10, 8)
  longitude  Decimal?         @db.Decimal(11, 8)
  notes      Json?
  riskLevel  RiskLevel?
  status     InspectionStatus @default(draft)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  request  InspectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  site     Site              @relation(fields: [siteId], references: [id])
  engineer User              @relation(fields: [engineerId], references: [id])
  media    Media[]
  reports  Report[]
  chatMessages ChatMessage[]

  @@index([requestId])
  @@index([siteId, createdAt])
  @@index([engineerId, status])
}

model Media {
  id           String   @id @default(uuid())
  inspectionId String
  type         String // photo | video
  url          String
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  caption      String?
  createdAt    DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model Report {
  id                String   @id @default(uuid())
  inspectionId      String
  pdfUrl            String?
  engineerSignature String?
  submissionDate    DateTime @default(now())
  version           Int      @default(1)
  createdAt         DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model InspectionTemplate {
  id             String   @id @default(uuid())
  name           String
  description    String?
  checklistItems Json     @default("[]")
  createdBy      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model RolePermission {
  id         String  @id @default(uuid())
  role       AppRole
  permission String

  @@unique([role, permission])
}

// Group chat for a site (inspectionId null) and the discussion thread attached
// to a single inspection (inspectionId set, siteId denormalised so access checks
// and room fan-out never need a join).
model ChatMessage {
  id           String   @id @default(uuid())
  siteId       String
  inspectionId String?
  authorId     String
  body         String
  replyToId    String?
  // Generated by the sender's device so a message queued offline and retried is
  // stored once. Unique per author; null for messages sent without one.
  clientId     String?
  // End-to-end encrypted messages: `body` is empty and the server only ever holds
  // ciphertext. The sender device's signature over it stops one member forging
  // another's messages (every member holds the shared conversation key).
  encrypted      Boolean @default(false)
  ciphertext     String?
  iv             String?
  keyEpoch       Int?
  senderDeviceId String?
  signature      String?
  createdAt    DateTime @default(now())

  site       Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  inspection Inspection?   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id])
  replyTo    ChatMessage?  @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    ChatMessage[] @relation("ChatReplies")
  attachments ChatAttachment[]

  @@index([siteId, inspectionId, createdAt])
  @@unique([authorId, clientId])
}

// A browser or phone a user has set up for end-to-end encrypted chat. The private
// halves never leave the device (apart from the passphrase-encrypted KeyBackup).
model UserDevice {
  id            String    @id @default(uuid())
  userId        String
  label         String
  // base64 SPKI. ECDH P-256: lets others wrap conversation keys for this device.
  encryptionKey String
  // base64 SPKI. ECDSA P-256: verifies messages this device signed.
  signingKey    String
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  wraps ChatKeyWrap[]

  @@unique([userId, encryptionKey])
  @@index([userId])
}

// The user's private keys, encrypted on their device with a passphrase before upload.
// The server stores an opaque blob it cannot open; it only lets a new device fetch it.
model KeyBackup {
  userId    String   @id
  blob      String
  salt      String
  kdf       Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One generation of a conversation's shared key. A new epoch is created whenever
// someone leaves or a device is revoked, so they cannot read what comes next.
model ChatKeyEpoch {
  id                String   @id @default(uuid())
  channelKey        String
  epoch             Int
  createdByDeviceId String
  createdAt         DateTime @default(now())

  wraps ChatKeyWrap[]

  @@unique([channelKey, epoch])
}

// The epoch key encrypted for one device (ECDH + AES-GCM, done by the client).
model ChatKeyWrap {
  id            String @id @default(uuid())
  epochId       String
  deviceId      String
  wrappedKey    String
  ephemeralKey  String
  iv            String

  epoch  ChatKeyEpoch @relation(fields: [epochId], references: [id], onDelete: Cascade)
  device UserDevice   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([epochId, deviceId])
  @@index([deviceId])
}

// How far a recipient has been delivered a channel's messages. Messages sent while
// they were offline are replayed from this cursor when they next connect.
// channelKey is the socket room name, e.g. "chat:site:<id>".
model ChatDelivery {
  id             String   @id @default(uuid())
  userId         String
  channelKey     String
  deliveredUntil DateTime
  // Newest message the recipient has opened and seen (drives the blue ticks).
  // Reading implies delivery, so this never runs ahead of deliveredUntil.
  readUntil      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelKey])
}

// A file or image sent with a chat message. The bytes live in storage under
// storageKey; access is always checked through the owning message's channel.
model ChatAttachment {
  id         String   @id @default(uuid())
  messageId  String
  fileName   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// A supporting file for a site: the proof behind a county / NEMA / NCA approval, or the
// building plan. One file per kind per site; uploading again replaces it.
model SiteDocument {
  id           String   @id @default(uuid())
  siteId       String
  kind         String // COUNTY_APPROVAL | NEMA_APPROVAL | NCA_APPROVAL | BUILDING_PLAN
  fileName     String
  mimeType     String
  size         Int
  storageKey   String
  uploadedById String?
  createdAt    DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, kind])
}
